# ---------------------------------------------------------------------------
# Mini Excel auth backend — copy to .env and fill in what you need.
# Everything is optional for local development.
# ---------------------------------------------------------------------------

# Core secrets (CHANGE THESE IN PRODUCTION)
AUTH_SECRET=dev-auth-secret-change-me
OTP_PEPPER=dev-otp-pepper-change-me

# Set to "production" on a real deployment. This makes AUTH_SECRET mandatory
# (the app refuses to boot without a unique value), marks cookies Secure, and
# stops internal error text being returned to the browser. Leave unset for
# local development.
AUTH_ENV=development

# Server
AUTH_PORT=5001
AUTH_DB_PATH=auth_app/auth.db

# Public base URL used to build OAuth callbacks. Leave unset to use the
# request host (fine for localhost development).
# OAUTH_REDIRECT_BASE=https://app.example.com

# --- OAuth providers -------------------------------------------------------
# Google:    https://console.cloud.google.com/apis/credentials
# GitHub:    https://github.com/settings/developers
# Microsoft: https://portal.azure.com > App registrations
#
# Register these callback URLs:
#   http://127.0.0.1:5001/auth/callback/google
#   http://127.0.0.1:5001/auth/callback/github
#   http://127.0.0.1:5001/auth/callback/microsoft

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- OTP email -------------------------------------------------------------
# Leave SMTP_HOST empty to use the console transport (codes are printed to the
# terminal and appended to auth_app/outbox.log).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1
